# =================================================================
# CORAX CRYPTO - MASTER CONFIGURATION
# Developed by: Pelle Nyberg (Corax CoLAB)
# https://github.com/PelleNybe | https://coraxcolab.com
# =================================================================

# --- Core Environment ---
CORAX_ENV=development # development | production
CORAX_MODE=testnet    # paper | testnet | mainnet (Controls Arc/Circle settlement)
DRY_RUN_MODE=True     # True = Paper trading (Safety), False = LIVE
PAPER_BALANCE_USDT=10000 # Starting capital in USDT for simulation
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR

# --- Arc L1 & Circle Hackathon Settings ---
ARC_RPC_URL=https://arc-node.thecanteenapp.com/
ARC_CHAIN_ID=         # Add Arc Chain ID from ARC-cli docs
CIRCLE_API_KEY=       # Add your Circle Sandbox API Key
PAYMASTER_ENABLED=True # Pay transaction fees in USDC (~$0.01)

# --- Exchange Credentials (Primary) ---
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSPHRASE=
SUBACCOUNT_ID=none

# --- Arbitrage Strategy Settings ---
# List of exchanges for asynchronous L2 monitoring via ccxt.pro
ARBITRAGE_EXCHANGES='["bitget","binance", "kraken", "bybit", "okx", "gateio"]'
MIN_ARBITRAGE_SPREAD_PCT=0.005 # Minimum profit margin (e.g., 0.5%)
MAX_ARBITRAGE_SLIPPAGE_PCT=0.001
ARB_EXECUTION_CONCURRENCY=True # Run buy/sell legs simultaneously via asyncio.gather
ACTIVE_STRATEGY=StatisticalArbitrage # Supports SMACrossover, FundingRateArb, OrderbookImbalance, StatisticalArbitrage

# --- Market Maker Settings ---
MARKET_MAKING_ENABLED=False
ORDER_DEPTH_LEVELS=5          # Number of limit orders in the order book
INVENTORY_SKEW_LIMIT=0.2      # Max portfolio imbalance before re-quoting
VOLATILITY_FACTOR_ADJUST=True # Adjust spreads automatically via RegimeDetector

# --- AI & LLM Copilot (EcoMind & InnoBrain) ---
LLM_PROVIDER=google           # google | openai
LLM_MODEL=gemini-3.1-flash-lite      # Or gpt-4-turbo
LLM_API_KEY=
NLP_INTENT_PARSING=True       # Enable natural language parsing via Telegram

# --- Risk & Safety Management ---
MAX_RISK_PER_TRADE_PCT=0.01   # Max 1% of capital per trade
DAILY_DRAWDOWN_LIMIT_PCT=0.05 # Stop all trading at 5% daily drawdown
MAX_OPEN_POSITIONS=10
GLOBAL_STOP_LOSS_PCT=0.03
AUTO_DELEVERAGE_ENABLED=True

# --- Hardware & Edge Optimization (Raspberry Pi 5 Spec) ---
CORAX_HARDWARE_BACKEND=CPU    # CPU | HAILO8L (For neural network inference)
DATA_PERSISTENCE_PATH=./data
TICK_BUFFER_SIZE=1000         # Number of ticks in RAM before flushing to NVMe SSD
USE_GPU_ACCELERATION=False

# --- Communication & UI ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUD_SERVER_PORT=8000
WEBGL_PARTICLE_INTENSITY=medium

# --- Web3 Bridge ---
WEB3_PROVIDER_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
DEX_MONITOR_ENABLED=False
MEMPOOL_TRACKING=False
# Circle / Arc Ledger Integration
USE_ARC_LEDGER=True
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_PUBLIC_KEY=your_circle_public_key_pem_here_or_leave_blank_to_fetch_via_api
CIRCLE_WALLET_ID=your_circle_wallet_id_here
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# Testnet Mode
CORAX_MODE=testnet